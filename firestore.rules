rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Collection: Everyone can read, owner can write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Projects Collection: Everyone can read, owner can write/delete
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // Services Collection: Everyone can read, owner can write/delete
    match /services/{serviceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    
    // Matches Collection: Only involved parties can read their specific matches
    match /matches/{projectId}/results/{freelancerId} {
       allow read: if request.auth != null && (
         // Freelancer can see their own score
         request.auth.uid == freelancerId || 
         // Client can see all scores for their project
         request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.authorUid
       );
       // Writing to matches is ONLY done via server-side backend
       allow write: if false; 
    }

    // Battles Collection: Everyone can read, authenticated users can create
    match /battles/{battleId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Battle Votes Subcollection: Track votes per user per battle
    match /battles/{battleId}/votes/{voterId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == voterId;
      allow update, delete: if request.auth != null && request.auth.uid == voterId;
    }
  }
}

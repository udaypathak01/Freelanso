NODE_ENV=development
PORT=5000
# Include the exact deployed frontend origin when deploying (HTTPS only in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_DATABASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROFILE_UPLOAD_PRESET=
CLOUDINARY_PROJECT_UPLOAD_PRESET=
CLOUDINARY_BATTLE_UPLOAD_PRESET=
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Set these together to enable Gemini 2.5 Flash: gemini / gemini-2.5-flash / server API key.
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=
WITHDRAWAL_MIN_MINOR=10000
WITHDRAWAL_MAX_MINOR=1000000
WALLET_CURRENCY=INR
